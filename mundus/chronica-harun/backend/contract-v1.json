  "bootstrapVersionHash": "9ac56399",
  "authControllerVersionHash": "a2609f8f",
  "cloudSyncControllerVersionHash": "e4e27abc",
  "authVersionHash": "d78fb675",
  "cloudSyncVersionHash": "7b97ff8f"
}
