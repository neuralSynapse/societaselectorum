{
  "service": "chronica-harun-backend",
  "schemaVersion": "1.5.0",
  "environment": "prod",
  "dataApiBase": "https://ep-green-hill-acstnnfu.apirest.sa-east-1.aws.neon.tech/chronica_harun/rest/v1",
  "authBase": "https://ep-green-hill-acstnnfu.neonauth.sa-east-1.aws.neon.tech/chronica_harun/auth",
  "healthDirect": "https://chronica-harun-backend.vercel.app/api/health",
  "healthProxyFallback": null,
  "adapterAsset": "games/chronica-harun/backend/adapter-v1.js",
  "bootstrapAsset": "games/chronica-harun/backend/bootstrap-v1.js",
  "authControllerAsset": "games/chronica-harun/backend/auth-controller-v1.js",
  "authAsset": "games/chronica-harun/backend/auth-v1.js",
  "cloudSyncControllerAsset": "games/chronica-harun/backend/cloud-sync-controller-v1.js",
  "cloudSyncAsset": "games/chronica-harun/backend/sync-v1.js",
  "authSdk": "@neondatabase/neon-js@0.7.0-beta",
  "identityRule": "user_id is always derived server-side from Neon Auth JWT",
  "realProgressRule": "real_progress_gate is read-only to authenticated clients; canonical mutations remain privileged server-side only",
  "rpc": [
    "start_run",
    "append_run_event",
    "finish_run",
    "upsert_speculi",
    "unlock_codex",
    "save_campaign",
    "update_world_state",
    "record_relic",
    "record_telemetry",
    "campaign_snapshot"
  ],
  "payloadLimitsBytes": {
    "profileSettings": 131072,
    "runStats": 262144,
    "runEventPayload": 65536,
    "speculiContent": 262144,
    "speculiCausality": 131072,
    "codexState": 131072,
    "relicState": 131072,
    "worldState": 524288,
    "saveState": 1048576,
    "telemetryPayload": 65536,
    "featureFlagConfig": 65536
  },
  "productionFlags": {
    "backendPersistence": true,
    "posthogTelemetry": false,
    "rendererV2": false
  },
  "liveRuntimeReferenced": true,
  "integrationMode": "isolated authenticated persistence layer loaded after the v0.9 runtime; guest play remains local; Neon Auth uses auth.token() with legacy session.access_token fallback; JWT enables RLS-protected remote saves, run lifecycle and telemetry; save conflicts require explicit user choice; authenticated E2E and cross-user isolation verified",
